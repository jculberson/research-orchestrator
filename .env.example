# Supabase (local CLI defaults from `supabase start`)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_KEY=replace-with-service-role-or-secret-key

# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.1

# Web search providers (used for "what's new since last run" queries)
# Comma-separated, e.g. "brave,reddit"
SEARCH_PROVIDERS=brave
BRAVE_API_KEY=replace-with-brave-search-api-key

# Reddit (create an app at https://www.reddit.com/prefs/apps, type "script")
REDDIT_CLIENT_ID=replace-with-reddit-client-id
REDDIT_CLIENT_SECRET=replace-with-reddit-client-secret
REDDIT_USER_AGENT=research-orchestrator/0.1

# SEC EDGAR requires a descriptive User-Agent with contact info
SEC_USER_AGENT=research-orchestrator your-email@example.com
